# ==============================================================================
# BIDWAR PREMIER LEAGUE — KIDS VERSION (SEASON 1) — ENVIRONMENT TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. STANDALONE NEON POSTGRESQL DATABASE (Production Required)
# ------------------------------------------------------------------------------
# Connection string to Neon PostgreSQL with SSL
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. STANDALONE CLOUDINARY MEDIA STORAGE (Production Required)
# ------------------------------------------------------------------------------
# Used for server-side direct streaming of player photos, logos & payment proofs
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 4. FAST2SMS OTP SMS SERVICE — BIDWAR CORE STANDARD (Production Required)
# ------------------------------------------------------------------------------
# Used for sending and verifying phone OTP during registration and team access
BULKSMS_KEY=
BULKSMS_TEMPLATE_ID=

# ------------------------------------------------------------------------------
# 5. SESSION & ADMIN SECURITY (Production Required)
# ------------------------------------------------------------------------------
# Cryptographic secret key for signing auth session JWTs (minimum 32 characters)
SESSION_SECRET=

# Private API key for administrative endpoints and committee verification
ADMIN_API_KEY=

# ------------------------------------------------------------------------------
# 6. RESEND TRANSACTIONAL EMAIL SERVICE (Production Required)
# ------------------------------------------------------------------------------
# Used for sending registration receipt and confirmation emails
RESEND_API_KEY=
MAIL_FROM=BidWar Premier League <bpl@bidwar.in>
EMAIL_ENABLED=true
ADMIN_NOTIFICATION_EMAIL=

# ------------------------------------------------------------------------------
# 7. TOURNAMENT REGISTRATION WINDOW (Optional - Defaults to Official Tournament Window)
# ------------------------------------------------------------------------------
# Authoritative tournament clock boundary (ISO 8601 with timezone)
REGISTRATION_START_TIME=2026-09-08T00:00:00+05:30
REGISTRATION_END_TIME=2026-10-15T23:59:59+05:30
REGISTRATION_ENABLED=true

# ------------------------------------------------------------------------------
# 8. DEVELOPMENT ONLY FLAGS (Strictly ignored in production)
# ------------------------------------------------------------------------------
# Set to true only in development to use test OTP (123456)
DEV_MOCK_AUTH=false
